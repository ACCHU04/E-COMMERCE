# Environment variable template — copy to .env and fill in your values

# Google Gemini API key (get yours at https://aistudio.google.com/)
# Without this key, the app runs in MOCK MODE with pre-built chart responses
GEMINI_API_KEY=your_gemini_api_key_here

# Backend settings (optional — defaults shown)
# DB_PATH=ecommerce.db
# DATA_DIR=../data
# DEFAULT_CSV=amazon_sales.csv

# Frontend settings (optional)
# NEXT_PUBLIC_API_URL=http://localhost:8000
